# Copy to .env:  cp .env.example .env
# Defaults run with zero setup: mock LLM, in-memory cache.

# --- LLM provider: mock | groq | gemini ---
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=500

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cache ---
# Empty = in-memory cache. Example: redis://default:<password>@<host>:<port>
REDIS_URL=
# Leave unset to use the evaluated default for EMBEDDING_MODEL (see eval/results.md).
# CACHE_SIMILARITY_THRESHOLD=0.70
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=10000
# Veto matches that differ in negation, numbers or on/off actions.
CACHE_GUARDS=true

# --- Embeddings ---
# all-mpnet-base-v2 has the best expected latency; all-MiniLM-L6-v2 fits a 512MB host.
EMBEDDING_MODEL=all-mpnet-base-v2

# --- RAG ---
RAG_TOP_K=3

# --- API ---
MAX_QUERY_CHARS=2000
WARMUP_ON_STARTUP=true
# Enables DELETE /cache (send as X-Admin-Token). Leave empty to disable.
ADMIN_TOKEN=
LOG_LEVEL=INFO
