# --- LLM provider selection ---
# Options: mock | groq | gemini
LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Cache ---
# Leave REDIS_URL empty to use the in-memory cache (zero setup, great for local dev).
# Example hosted value: redis://default:<password>@<host>:<port>
REDIS_URL=

# Cosine similarity threshold above which a cached answer is reused (0-1).
CACHE_SIMILARITY_THRESHOLD=0.90

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG ---
RAG_TOP_K=3
